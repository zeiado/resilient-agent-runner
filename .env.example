# Copy to .env to override the defaults in docker-compose.yml. Nothing here is required.

POSTGRES_USER=runner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=runner

# "mock" (default, no key needed), "claude" or "ollama"
LLM_PROVIDER=mock

# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# LLM_PROVIDER=ollama: any OpenAI-compatible endpoint. The defaults point at the "ollama"
# compose service (profile local-llm), which ignores the API key.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:3b
OPENAI_API_KEY=ollama

# Seconds MockLLM waits before each decision. The demo sets this so there is time to kill the worker.
MOCK_LLM_DELAY_SECONDS=0

HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_STALE_SECONDS=60
REAPER_INTERVAL_SECONDS=30
